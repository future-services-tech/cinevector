# PostgreSQL
POSTGRES_DB=cinevector
POSTGRES_USER=cinevector
POSTGRES_PASSWORD=change_me

# Connection string usata da Api/Worker (deve puntare al servizio "postgres" nel network Docker)
CONNECTIONSTRINGS__POSTGRES=Host=postgres;Port=5432;Database=cinevector;Username=cinevector;Password=change_me
CONNECTIONSTRINGS__REDIS=redis:6379

# TMDb (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# OMDb (http://omdbapi.com/apikey.aspx)
OMDB_API_KEY=

# OmniRouter (embedding provider OpenAI-compatible)
OMNIROUTER_API_KEY=

# Spotify (Authorization Code Flow, solo catalogo pubblico — https://developer.spotify.com/dashboard)
# Redirect URI da registrare su OGNI app Spotify: http://127.0.0.1:5174/callback (loopback IPv4, non "localhost")
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# App di fallback (opzionale ma consigliata): usata automaticamente se la primaria viene bloccata/limitata
SPOTIFY_FB_CLIENT_ID=
SPOTIFY_FB_CLIENT_SECRET=

# pgAdmin (solo sviluppo)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me
