# CineVector - variabili di PRODUZIONE (usate da docker-compose.prod.yml).
# Copia questo file in ".env" sul server e compila i valori. Non committare mai ".env".

# --- Traefik / dominio -------------------------------------------------------------------------------------
# L'app risponderà su https://<COMPOSE_PROJECT_NAME>.<TRAEFIK_HOST>
COMPOSE_PROJECT_NAME=cinevector
TRAEFIK_HOST=example.com

# --- PostgreSQL (obbligatorio) -----------------------------------------------------------------------------
POSTGRES_DB=cinevector
POSTGRES_USER=cinevector
# Password lunga e casuale. Evita ';' e '=' (finisce in una connection string).
POSTGRES_PASSWORD=

# --- Provider dati / embedding -----------------------------------------------------------------------------
# TMDb (obbligatorio) - https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# OMDb (facoltativo) - http://omdbapi.com/apikey.aspx
OMDB_API_KEY=
# Embedding provider OpenAI-compatible (obbligatorio: senza, la ricerca semantica non funziona)
EMBEDDING__BASEURL=
OMNIROUTER_API_KEY=

# --- Spotify (facoltativo) ---------------------------------------------------------------------------------
# Registra su OGNI app Spotify il Redirect URI: https://<COMPOSE_PROJECT_NAME>.<TRAEFIK_HOST>/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# App di riserva, usata automaticamente se la primaria viene limitata
SPOTIFY_FB_CLIENT_ID=
SPOTIFY_FB_CLIENT_SECRET=
