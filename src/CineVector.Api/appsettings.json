{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] ({TraceId}) {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },

  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=cinevector;Username=cinevector;Password=CHANGE_ME",
    "Redis": "localhost:6379"
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },

  "Crawler": {
    "Enabled": true,
    "DelayMilliseconds": 1000,
    "MaxConcurrency": 2
  },

  "Tmdb": {
    "BaseUrl": "https://api.themoviedb.org/3",
    "ImageBaseUrl": "https://image.tmdb.org/t/p",
    "ApiKeyEnvironmentVariable": "TMDB_API_KEY"
  },

  "Spotify": {
    "AuthBaseUrl": "https://accounts.spotify.com/",
    "ApiBaseUrl": "https://api.spotify.com/v1/",
    "RedirectUri": "http://127.0.0.1:5174/callback",
    "Scope": ""
  },

  "Embedding": {
    "Provider": "OmniRouter",
    "BaseUrl": "https://omniroute-ehdl.srv1293923.hstgr.cloud/v1",
    "Model": "gemini/gemini-embedding-001",
    "Dimensions": 384,
    "ApiKeyEnvironmentVariable": "OMNIROUTER_API_KEY"
  },

  "Search": {
    "SemanticWeight": 0.50,
    "FullTextWeight": 0.35,
    "MetadataWeight": 0.15
  },

  "Clustering": {
    "K": 12,
    "MaxIterations": 100,
    "LabelGenreCount": 2,
    "LabelKeywordCount": 1
  },

  "SimilarMovies": {
    "MinSimilarity": 0.3,
    "MaxResults": 20,
    "GenreWeight": 0.10,
    "YearWeight": 0.05,
    "YearDecayRange": 20
  },

  "AllowedHosts": "*"
}
